# OpenAI image model powers the AI business card designer
OPENAI_API_KEY=
# Stripe (EDZ Solutions account). Test key sk_test_... until launch
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook pointed at https://<site>/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=
# Public site URL, used for Stripe redirects and links in alert emails
SITE_URL=http://localhost:3000
# Password for /admin (any username)
ADMIN_PASSWORD=
# Postgres. Heroku sets this automatically; locally defaults to postgres://localhost/edz
DATABASE_URL=
# Order / inquiry alert emails (any SMTP mailbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ORDER_ALERT_TO=
# Cold outreach. Use SEPARATE domains' mailboxes so spam complaints can't hurt edzsolutions.com.
# The site sends on its own on weekdays inside OUTREACH_WINDOW (hours, OUTREACH_TZ time), one email
# per mailbox every 10 minutes. Each mailbox warms up: 5 a day from its start date, +2 a day, up to max.
OUTREACH_SMTP_HOST=mail.spacemail.com
OUTREACH_SMTP_PORT=465
OUTREACH_MAILBOXES=[{"user":"info@domain-one.com","pass":"...","start":"2026-11-15","max":30}]
OUTREACH_FROM_NAME=Ty at EDZ Solutions
OUTREACH_SENDER_NAME=
# Postal address shown in every email (required by law). A PO box or registered agent address works.
OUTREACH_ADDRESS=
OUTREACH_PHONE=
# Total across all mailboxes per 24 hours
OUTREACH_DAILY_LIMIT=50
OUTREACH_TZ=America/Chicago
OUTREACH_WINDOW=8-14
# Set to 1 to stop all outreach sending
OUTREACH_PAUSED=

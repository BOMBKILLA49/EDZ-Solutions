# OpenAI image model powers the AI business card designer
OPENAI_API_KEY=
# Stripe (EDZ Solutions account). Test key sk_test_... until launch
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook pointed at https://<site>/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=
# Public site URL, used for Stripe redirects and links in alert emails
SITE_URL=http://localhost:3000
# Password for /admin (any username)
ADMIN_PASSWORD=
# Postgres. Heroku sets this automatically; locally defaults to postgres://localhost/edz
DATABASE_URL=
# Order / inquiry alert emails (any SMTP mailbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ORDER_ALERT_TO=
